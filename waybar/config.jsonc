{
  "reload_style_on_change": true,
  "toggle": true,
  "layer": "top",
  "position": "right",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "include": ["~/.config/waybar/modules_vertical.json"],
  "modules-left": ["clock", "custom/random-message"],
  "modules-center": ["mpris", "niri/workspaces", "privacy"],
  "modules-right": [
    "group/extras",
    "pulseaudio#microphone",
    "group/audio",
    "group/brightness",
    "battery"
  ]
}
