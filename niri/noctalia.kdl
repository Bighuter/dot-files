layout {

    focus-ring {
        active-color   "#006591"
        inactive-color "#f9f9fc"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#006591"
        inactive-color "#f9f9fc"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#006591"
        inactive-color "#c9e6ff"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00659180"
    }
}

recent-windows {
    highlight {
        active-color "#006591"
        urgent-color "#ba1a1a"
    }
}
